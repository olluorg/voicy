# исходники синтеза — восстанавливаются скриптами, в репозиторий едет opus
*.wav
# ...кроме поставляемых голосов — они часть крейта ядра
!rust/core/assets/voices/*.wav
*.pt
*.onnx
__pycache__/
*-venv/
.venv/

# файлы, которые CLI назвал сам, когда имя не указали
voicy-[0-9]*.*

# рабочий каталог CLI: pid и журнал локального сервера
.voicy/

# профили контекста распознавания и голоса — данные пользователя; поставляемые
# голоса лежат в rust/core/assets/voices, и сервер кладёт их сюда сам
server/contexts/
server/voices/
rust/target/

# рабочие данные экспериментов: корпуса, веса, промежуточный звук
experiments/*/work/

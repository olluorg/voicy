def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(
        prog="voicy", description="локальный синтез и распознавание речи",
        epilog=f"адрес сервера: VOICY_URL (сейчас {DEFAULT_URL})")
    p.add_argument("--url", default=DEFAULT_URL, help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("say", help="текст → аудиофайл")
    s.add_argument("text", help="текст, либо @файл, либо - для stdin")
    s.add_argument("out", nargs="?", help="куда писать; расширение задаёт формат")
    s.add_argument("--voice", help="имя голоса (по умолчанию — серверный)")
    s.add_argument("--format", default="opus", choices=AUDIO_FORMATS)
    s.add_argument("--speed", type=float, default=1.0, help="0.8–1.2, растяжением готового звука")
    s.add_argument("--language", help="ru, en … (по умолчанию — серверный, русский)")
    s.add_argument("--seed", type=int)
    s.add_argument("--prepare", action="store_true", help="применить словарь произношений")
    s.add_argument("--legato", action="store_true", help="убрать запятые внутри коротких фраз")
    s.add_argument("--no-stress", action="store_true",
                   help="без знаков ударения (по умолчанию их ставит сервер, если модель их понимает)")
    s.add_argument("--detach", action="store_true",
                   help="не ждать: напечатать id задания и выйти")
    s.add_argument("--webhook", metavar="URL", help="POST сюда, когда готово (подразумевает --detach)")
    s.add_argument("--timeout", type=float, default=1800)
    s.set_defaults(fn=cmd_say)

    s = sub.add_parser("music", help="описание (и текст песни) → музыка")
    s.add_argument("prompt", help="жанр, инструменты, настроение, голос; либо @файл, либо - для stdin")
    s.add_argument("out", nargs="?", help="куда писать; расширение задаёт формат")
    s.add_argument("--lyrics", help="текст песни с разметкой [verse], [chorus]; @файл — из файла")
    s.add_argument("--instrumental", action="store_true", help="без голоса")
    s.add_argument("--language", help="язык текста: ru, en …")
    s.add_argument("--duration", type=float, help="секунд; без него длину выбирает модель")
    s.add_argument("--model", help="модель; список — music-models")
    s.add_argument("--format", default="opus", choices=AUDIO_FORMATS)
    s.add_argument("--seed", type=int)
    s.add_argument("--detach", action="store_true", help="не ждать: напечатать id задания и выйти")
    s.add_argument("--webhook", metavar="URL", help="POST сюда, когда готово (подразумевает --detach)")
    s.add_argument("--timeout", type=float, default=1800)
    s.set_defaults(fn=cmd_music)

    s = sub.add_parser("music-models", help="модели музыки и что каждая умеет")
    s.set_defaults(fn=cmd_music_models)

    s = sub.add_parser("hear", help="аудиофайл → текст")
    s.add_argument("file")
    s.add_argument("--language", help="ru, en … (по умолчанию определяется)")
    s.add_argument("--format", default="json", choices=("json", "text", "verbose_json", "srt", "vtt"))
    s.add_argument("--prompt", help="подсказка контекста: термины, имена")
    s.add_argument("--temperature", type=float, default=0.0)
    s.add_argument("--words", action="store_true", help="отметки времени по словам")
    s.add_argument("--context", help="профиль контекста: термины и замены (см. contexts)")
    s.add_argument("--hotwords", help="термины через запятую: Kafka, Grafana, Helm")
    s.add_argument("--detach", action="store_true",
                   help="не ждать: напечатать id задания и выйти")
    s.add_argument("--webhook", metavar="URL", help="POST сюда, когда готово (подразумевает --detach)")
    s.add_argument("--timeout", type=float, default=1800)
    s.set_defaults(fn=cmd_hear)

    s = sub.add_parser("job", help="состояние задания; готовое — в файл или stdout")
    s.add_argument("id")
    s.add_argument("out", nargs="?", help="куда писать звук, если это синтез")
    s.add_argument("--wait", action="store_true", help="дождаться конца")
    s.add_argument("--format", default="json", choices=("json", "text", "verbose_json", "srt", "vtt"),
                   help="формат расшифровки")
    s.set_defaults(fn=cmd_job)

    s = sub.add_parser("jobs", help="задания и очередь")
    s.set_defaults(fn=cmd_jobs)

    s = sub.add_parser("cancel", help="отменить задание")
    s.add_argument("id")
    s.set_defaults(fn=cmd_cancel)

    s = sub.add_parser("contexts", help="профили контекста распознавания")
    s.set_defaults(fn=cmd_contexts)

    s = sub.add_parser("voices", help="список голосов")
    s.set_defaults(fn=cmd_voices)

    s = sub.add_parser("add-voice", help="добавить голос из образца 8–14 с")
    s.add_argument("file")
    s.add_argument("name")
    s.add_argument("--text", help="расшифровка; по умолчанию распознаётся сервером")
    s.add_argument("--note", help="пометка для списка")
    s.add_argument("--replace", action="store_true", help="перезаписать голос с тем же именем")
    s.add_argument("--timeout", type=float, default=600)
    s.set_defaults(fn=cmd_add_voice)

    s = sub.add_parser("prepare", help="словарь произношений и снятие запятых")
    s.add_argument("text", help="текст, либо @файл, либо -")
    s.add_argument("--no-dictionary", action="store_true")
    s.add_argument("--legato", action="store_true")
    s.add_argument("--no-stress", action="store_true")
    s.set_defaults(fn=cmd_prepare)

    s = sub.add_parser("up", help="поднять сервер и дождаться готовности")
    s.add_argument("--native", "--source", dest="mode", action="store_const", const="native",
                   default="auto", help="бинарником на Rust, без docker")
    s.add_argument("--docker", dest="mode", action="store_const", const="docker",
                   help="только через docker, без запасного пути")
    s.add_argument("--install", action="store_true",
                   help="собрать бинарник, если его нет, и скачать модели не спрашивая")
    s.add_argument("--build", action="store_true", help="собрать образ из исходников")
    s.add_argument("--cpu", action="store_true", help="без GPU")
    s.add_argument("--wait", type=float, default=3600, help="сколько ждать готовности, с")
    s.add_argument("--no-warm", dest="warm", action="store_false", help="не прогревать модели")
    s.add_argument("--timeout", type=float, default=1800)
    s.set_defaults(fn=cmd_up)

    s = sub.add_parser("down", help="остановить сервер")
    s.set_defaults(fn=cmd_down)

    s = sub.add_parser("status", help="состояние моделей и устройства")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("warm", help="загрузить модели заранее")
    s.add_argument("--timeout", type=float, default=1800)
    s.set_defaults(fn=cmd_warm)

    a = p.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)

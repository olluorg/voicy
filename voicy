#!/usr/bin/env python3
"""voicy — однострочный доступ к локальному речевому серверу.

Обёртка поверх HTTP-API для тех, кому нужен звук, а не протокол:

    ./voicy say "текст" out.opus
    ./voicy hear out.opus
    ./voicy up

Зависимостей нет — только стандартная библиотека, поэтому работает и там,
где окружение сервера не установлено.

Разделение потоков умышленное: в stdout уходит результат (путь к файлу,
расшифровка, список голосов), в stderr — всё остальное. Поэтому
`TEXT=$(./voicy hear запись.opus)` даёт ровно текст.
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import NoReturn
from urllib.parse import urlsplit
from uuid import uuid4

HERE = Path(__file__).resolve().parent
# 127.0.0.1, а не localhost: на Windows это имя разрешается сначала в IPv6 ::1,
# где сервер не слушает, и клиент получает отказ вместо ответа.
DEFAULT_URL = os.environ.get("VOICY_URL", "http://127.0.0.1:8080")
# Ключ, если сервер его требует; тот же, что задан серверу в VOICY_API_KEY.
# Серверу можно дать несколько через запятую — клиенту нужен один.
API_KEY = os.environ.get("VOICY_API_KEY", "").split(",")[0].strip()

# Форматы синтеза, которые принимает сервер; opus по умолчанию — он компактный
# и его понимает всё, что умеет читать аудио.
AUDIO_FORMATS = ("opus", "wav", "mp3", "flac", "aac", "pcm")
EXT_CONTENT_TYPE = {".wav": "audio/wav", ".mp3": "audio/mpeg", ".opus": "audio/ogg",
                    ".ogg": "audio/ogg", ".flac": "audio/flac", ".m4a": "audio/mp4",
                    ".aac": "audio/aac", ".webm": "audio/webm"}


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"voicy: {msg}", file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------- запросы

def _opener(url: str):
    """Локальный адрес — мимо прокси.

    Если в окружении задан HTTP_PROXY, клиент пойдёт к собственному серверу
    через прокси и получит 503. Здесь это лечится за вызывающего, а не заметкой
    в документации.
    """
    host = urlsplit(url).hostname or ""
    if host in ("localhost", "127.0.0.1", "::1", "0.0.0.0"):
        return urllib.request.build_opener(urllib.request.ProxyHandler({}))
    return urllib.request.build_opener()


def request(url: str, path: str, *, data: bytes | None = None,
            content_type: str | None = None, timeout: float = 30.0,
            hint: str = "", method: str | None = None):
    """Возвращает (тело, заголовки). Ошибки соединения переводит в понятные."""
    req = urllib.request.Request(url.rstrip("/") + path, data=data,
                                 method=method or ("POST" if data else "GET"))
    if content_type:
        req.add_header("Content-Type", content_type)
    if API_KEY:
        req.add_header("Authorization", f"Bearer {API_KEY}")
    try:
        with _opener(url).open(req, timeout=timeout) as r:
            # Регистр имён заголовков у серверов и прокси разный:
            # x-voice и X-Voice — один заголовок.
            return r.read(), {k.lower(): v for k, v in r.headers.items()}
    except urllib.error.HTTPError as e:
        body = e.read()
        detail = ""
        try:
            err = json.loads(body)
            detail = (err.get("error") or {}).get("message") or err.get("detail", "")
        except Exception:
            detail = body[:300].decode("utf-8", "replace")
        if e.code == 401:
            hint = ("сервер требует ключ: VOICY_API_KEY=... " + sys.argv[0] + " ..."
                    if not API_KEY else "ключ в VOICY_API_KEY не подходит")
        die(f"сервер ответил {e.code}: {detail or e.reason}"
            + (f"\n       {hint}" if hint else ""))
    except urllib.error.URLError as e:
        die(f"{url} не отвечает ({e.reason}).\n"
            f"       Поднять сервер: {sys.argv[0]} up\n"
            f"       Другой адрес:   VOICY_URL=http://host:port {sys.argv[0]} ...")
    except TimeoutError:
        die(f"истёк таймаут запроса к {url}. Длинный текст? Увеличьте --timeout")


def post_json(url: str, path: str, payload: dict, timeout: float, hint: str = ""):
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    return request(url, path, data=body, content_type="application/json",
                   timeout=timeout, hint=hint)


def post_multipart(url: str, path: str, fields: dict, files: dict, timeout: float):
    boundary = uuid4().hex
    body = bytearray()
    for k, v in fields.items():
        if v is None:
            continue
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n"
                 f"{v}\r\n").encode("utf-8")
    for k, (filename, data, ctype) in files.items():
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"; "
                 f"filename=\"{filename}\"\r\nContent-Type: {ctype}\r\n\r\n").encode("utf-8")
        body += data + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    return request(url, path, data=bytes(body), timeout=timeout,
                   content_type=f"multipart/form-data; boundary={boundary}")


def health(url: str, timeout: float = 5.0) -> dict | None:
    """Состояние сервера, либо None — если на адресе тишина или не voicy."""
    req = urllib.request.Request(url.rstrip("/") + "/health")
    try:
        with _opener(url).open(req, timeout=timeout) as r:
            data = json.loads(r.read())
    except Exception:
        return None
    # На порту может сидеть чужое приложение: у него нет ни tts, ни stt.
    if not isinstance(data, dict) or "tts" not in data or "stt" not in data:
        return None
    return data


def require_server(url: str) -> dict:
    h = health(url)
    if h:
        return h
    # Различаем «никого нет» и «есть кто-то другой» — это чинится по-разному.
    try:
        with _opener(url).open(urllib.request.Request(url.rstrip("/") + "/health"), timeout=3):
            pass
        alive = True
    except urllib.error.HTTPError:
        alive = True
    except Exception:
        alive = False
    if alive:
        die(f"на {url} отвечает не voicy — порт занят другим приложением.\n"
            f"       Укажите свободный: VOICY_PORT=8090 {sys.argv[0]} up\n"
            f"                          VOICY_URL=http://localhost:8090 {sys.argv[0]} say ...")
    die(f"сервер не запущен на {url}. Поднять: {sys.argv[0]} up")


def wait_healthy(url: str, deadline: float) -> dict:
    """Ждёт, пока сервер начнёт отвечать. Веса качаются долго, это нормально."""
    last = 0.0
    while time.time() < deadline:
        h = health(url, timeout=3.0)
        if h:
            return h
        if time.time() - last > 15:
            log(f"  ждём {url} … ({int(deadline - time.time())} с в запасе)")
            last = time.time()
        time.sleep(2)
    die(f"сервер так и не ответил на {url}.\n"
        f"       Журнал: docker compose logs -f voicy")


# ---------------------------------------------------------------------- say

def read_text(source: str) -> str:
    """`-` читает stdin, `@файл` — файл, всё остальное — сам текст."""
    if source == "-":
        return sys.stdin.read()
    if source.startswith("@"):
        p = Path(source[1:])
        if not p.exists():
            die(f"файл не найден: {p}")
        return p.read_text(encoding="utf-8")
    return source


def cmd_say(a) -> int:
    text = read_text(a.text).strip()
    if not text:
        die("пустой текст")

    out = Path(a.out) if a.out else Path(f"voicy-{int(time.time())}.{a.format}")
    if str(out) == "-":
        die("аудио в stdout не пишется — бинарь засорит вывод. Укажите файл: "
            f"{sys.argv[0]} say \"...\" out.{a.format}")
    fmt = a.format
    if a.out and out.suffix.lstrip(".").lower() in AUDIO_FORMATS:
        fmt = out.suffix.lstrip(".").lower()      # расширение важнее флага

    h = require_server(a.url)
    if not h["tts"]["loaded"]:
        log("модель синтеза ещё не в памяти — первый вызов дольше обычного "
            "(а самый первый запуск сервера ещё и качает веса)")

    payload = {"input": text, "response_format": fmt, "speed": a.speed,
               "language": a.language, "prepare": a.prepare, "legato": a.legato,
               "stress": not a.no_stress}
    if a.voice:
        payload["voice"] = a.voice
    if a.seed is not None:
        payload["seed"] = a.seed

    # ffmpeg серверу нужен только для aac: остальное он кодирует и растягивает сам.
    # В образе ffmpeg есть, у бинарника на машине — системная зависимость.
    hint = ""
    if fmt == "aac" and not shutil.which("ffmpeg"):
        hint = "похоже, серверу не хватает ffmpeg: он нужен для aac. Поставьте его или возьмите opus"

    if a.detach or a.webhook:
        if a.webhook:
            payload["webhook_url"] = a.webhook
        body, _ = post_json(a.url, "/v1/jobs/speech", payload, 60, hint=hint)
        return detached(json.loads(body), f"{out}")

    started = time.perf_counter()
    audio, headers = post_json(a.url, "/v1/audio/speech", payload, a.timeout, hint=hint)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(audio)

    secs = headers.get("x-audio-seconds", "?")
    gen = headers.get("x-generation-seconds", f"{time.perf_counter() - started:.1f}")
    log(f"{headers.get('x-voice', '?')}: {secs} с звука за {gen} с, "
        f"{len(audio) / 1024:.0f} КиБ")
    print(out)
    return 0


# -------------------------------------------------------------------- music

def cmd_music(a) -> int:
    prompt = read_text(a.prompt).strip()
    if not prompt:
        die("пустое описание музыки")
    lyrics = read_text(a.lyrics).strip() if a.lyrics else ""
    out = Path(a.out) if a.out else Path(f"voicy-music-{int(time.time())}.{a.format}")
    if str(out) == "-":
        die("аудио в stdout не пишется — бинарь засорит вывод. Укажите файл: "
            f"{sys.argv[0]} music \"...\" out.{a.format}")
    fmt = a.format
    if a.out and out.suffix.lstrip(".").lower() in AUDIO_FORMATS:
        fmt = out.suffix.lstrip(".").lower()

    h = require_server(a.url)
    if not (h.get("music") or {}).get("default"):
        die("на сервере нет моделей музыки: voicy setup music")

    payload = {"prompt": prompt, "force_instrumental": a.instrumental, "response_format": fmt}
    for k, v in (("lyrics", lyrics), ("language", a.language), ("duration_seconds", a.duration),
                 ("model", a.model), ("seed", a.seed)):
        if v not in (None, ""):
            payload[k] = v
    if a.detach or a.webhook:
        if a.webhook:
            payload["webhook_url"] = a.webhook
        body, _ = post_json(a.url, "/v1/jobs/music", payload, 60)
        return detached(json.loads(body), f"{out}")

    started = time.perf_counter()
    audio, headers = post_json(a.url, "/v1/music", payload, a.timeout)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(audio)
    secs = headers.get("x-audio-seconds", "?")
    gen = headers.get("x-generation-seconds", f"{time.perf_counter() - started:.1f}")
    log(f"{headers.get('x-model', '?')}: {secs} с музыки за {gen} с, {len(audio) / 1024:.0f} КиБ")
    print(out)
    return 0


def cmd_music_models(a) -> int:
    body, _ = request(a.url, "/v1/music/models", timeout=30)
    models = json.loads(body).get("models", [])
    if not models:
        log("моделей музыки нет: voicy setup music")
    for m in models:
        can = ", ".join(w for k, w in (("vocals", "поёт"), ("instrumental", "инструментал")) if m.get(k))
        lic = m.get("license", "?") + ("" if m.get("commercial") else ", некоммерческая")
        print(f"{m['id']}{' (по умолчанию)' if m.get('default') else ''}\t{m.get('name', '')}; "
              f"{m.get('min_seconds')}–{m.get('max_seconds')} с; {can}; {lic}")
    return 0


# --------------------------------------------------------------------- hear

def cmd_hear(a) -> int:
    src = Path(a.file)
    if not src.exists():
        die(f"файл не найден: {src}")
    require_server(a.url)

    fields = {"model": "whisper-1", "response_format": a.format,
              "temperature": str(a.temperature)}
    if a.language:
        fields["language"] = a.language
    if a.prompt:
        fields["prompt"] = a.prompt
    if a.words:
        fields["timestamp_granularities"] = "word"
    if a.context:
        fields["context"] = a.context
    if a.hotwords:
        fields["hotwords"] = a.hotwords

    ctype = EXT_CONTENT_TYPE.get(src.suffix.lower(), "application/octet-stream")
    if a.detach or a.webhook:
        fields.pop("model"), fields.pop("response_format")
        fields.pop("timestamp_granularities", None)
        fields["word_timestamps"] = str(a.words).lower()
        fields["webhook_url"] = a.webhook
        body, _ = post_multipart(a.url, "/v1/jobs/transcribe", fields,
                                 {"file": (src.name, src.read_bytes(), ctype)}, 600)
        return detached(json.loads(body), f"--format {a.format}")

    body, _ = post_multipart(a.url, "/v1/audio/transcriptions", fields,
                             {"file": (src.name, src.read_bytes(), ctype)}, a.timeout)
    text = body.decode("utf-8", "replace")
    if a.format == "json":
        try:
            text = json.loads(text)["text"]
        except Exception:
            pass
    print(text.strip())
    return 0


# --------------------------------------------------------------------- jobs

def detached(job: dict, rest: str) -> int:
    """Задание принято: в stdout — только id, чтобы его можно было подставить."""
    ahead = job.get("position") or 0
    log(f"задание {job['id']} принято" + (f", впереди {ahead}" if ahead else "") +
        f"\n       забрать: {sys.argv[0]} job {job['id']} {rest} --wait")
    print(job["id"])
    return 0


def cmd_job(a) -> int:
    require_server(a.url)
    last = None
    while True:
        body, _ = request(a.url, f"/v1/jobs/{a.id}", timeout=30)
        job = json.loads(body)
        if job["state"] in ("done", "error", "cancelled") or not a.wait:
            break
        stage = job["progress"].get("stage")
        note = (f"в очереди, впереди {job['position']}" if job["state"] == "queued"
                else stage)
        if note != last:
            log(f"  {note}")
            last = note
        time.sleep(1)

    if job["state"] != "done":
        if job["state"] == "error":
            die(f"задание {a.id} упало: {job['error']}")
        log(f"задание {a.id}: {job['state']}")
        if not a.out:
            print(json.dumps(job, ensure_ascii=False, indent=2))
        return 3 if job["state"] in ("queued", "running") else 1

    if job["kind"] in ("speech", "music"):
        if not a.out:
            print(json.dumps(job, ensure_ascii=False, indent=2))
            log(f"звук готов — укажите файл: {sys.argv[0]} job {a.id} out.{job['result']['format']}")
            return 0
        audio, _ = request(a.url, f"/v1/jobs/{a.id}/audio", timeout=600)
        out = Path(a.out)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_bytes(audio)
        who = job["result"].get("voice") or job["result"].get("model", "?")
        log(f"{who}: {job['result']['seconds']} с звука")
        print(out)
        return 0

    body, _ = request(a.url, f"/v1/jobs/{a.id}/result?format={a.format}", timeout=60)
    text = body.decode("utf-8", "replace")
    if a.format == "json":
        text = json.loads(text)["text"]
    print(text.strip())
    return 0


def cmd_jobs(a) -> int:
    require_server(a.url)
    body, _ = request(a.url, "/v1/jobs", timeout=30)
    data = json.loads(body)
    for j in data["data"]:
        extra = (f"впереди {j['position']}" if j["state"] == "queued" else
                 j.get("error") or "")
        print(f"{j['id']}  {j['kind']:<10} {j['state']:<9} {extra}")
    q = data["queue"]
    log(f"в очереди {q['pending']} из {q['max']}" +
        (f", работает {q['running']}" if q["running"] else ""))
    return 0


def cmd_cancel(a) -> int:
    require_server(a.url)
    body, _ = request(a.url, f"/v1/jobs/{a.id}", method="DELETE", timeout=30)
    job = json.loads(body)
    log("остановится на ближайшем шаге" if job.get("cancel_requested") else "отменено")
    print(job["id"])
    return 0


# ----------------------------------------------------------------- contexts

def cmd_contexts(a) -> int:
    require_server(a.url)
    body, _ = request(a.url, "/v1/contexts", timeout=10)
    for c in json.loads(body)["data"]:
        mark = "*" if c["builtin"] else " "
        print(f"{mark} {c['name']:<14} {len(c['hotwords']):>3} терм.  {c.get('note', '')}")
    log(f"свой: curl -X PUT {a.url}/v1/contexts/имя -H 'Content-Type: application/json' "
        "-d '{\"hotwords\": [...], \"replacements\": {...}}'")
    return 0


# ------------------------------------------------------------------- voices

def cmd_voices(a) -> int:
    require_server(a.url)
    body, _ = request(a.url, "/v1/voices", timeout=10)
    data = json.loads(body)
    for v in data["data"]:
        mark = "*" if v["name"] == data.get("default") else " "
        print(f"{mark} {v['name']:<14} {v.get('note', '')}")
    if not data["data"]:
        log(f"голосов нет — добавьте: {sys.argv[0]} add-voice образец.wav имя")
    return 0


def cmd_add_voice(a) -> int:
    src = Path(a.file)
    if not src.exists():
        die(f"файл не найден: {src}")
    require_server(a.url)
    ctype = EXT_CONTENT_TYPE.get(src.suffix.lower(), "audio/wav")
    # Расшифровку намеренно не требуем: сервер распознает образец сам,
    # и это точнее ручного ввода — а точность здесь решает качество клона.
    body, _ = post_multipart(a.url, "/v1/voices",
                             {"name": a.name, "text": a.text or "", "note": a.note or "",
                              "replace": str(a.replace).lower()},
                             {"file": (src.name, src.read_bytes(), ctype)}, a.timeout)
    v = json.loads(body)
    log(f"расшифровка образца: {v['reference_text']!r}")
    for w in v.get("warnings", []):
        log(f"внимание: {w}")
    print(v["name"])
    return 0


# ------------------------------------------------------------------ prepare

def cmd_prepare(a) -> int:
    require_server(a.url)
    payload = {"text": read_text(a.text), "dictionary": not a.no_dictionary,
               "legato": a.legato, "stress": not a.no_stress}
    body, _ = post_json(a.url, "/v1/text/prepare", payload, 30)
    print(json.loads(body)["text"])
    return 0


# ------------------------------------------------------------ up/down/status

def cmd_status(a) -> int:
    h = health(a.url)
    if not h:
        log(f"voicy не отвечает на {a.url}; поднять: {sys.argv[0]} up")
        return 1
    print(json.dumps(h, ensure_ascii=False, indent=2))
    return 0


def cmd_warm(a) -> int:
    """Прогрев: первый синтез грузит модель, и лучше это сделать заранее."""
    require_server(a.url)
    log("прогрев моделей …")
    started = time.perf_counter()
    post_json(a.url, "/v1/audio/speech",
              {"input": "Проверка связи.", "response_format": "wav"}, a.timeout)
    log(f"синтез готов ({time.perf_counter() - started:.0f} с)")
    return 0


IMAGE = os.environ.get("VOICY_IMAGE", "ghcr.io/olluorg/voicy:latest")
EXE = "voicy.exe" if os.name == "nt" else "voicy"
BUILT = HERE / "rust" / "target" / "release" / EXE
# Системы, под которые setup ставит движки в процесс сервера (rust/core/src/setup.rs).
NATIVE_ENGINES = (sys.platform in ("linux", "win32")
                  and platform.machine().lower() in ("x86_64", "amd64"))
BUILD = ["build", "--release", "--manifest-path", str(HERE / "rust" / "Cargo.toml")]


def docker_available() -> bool:
    """Docker может быть не установлен, а может быть сломан — разницы нет."""
    try:
        r = subprocess.run(["docker", "version", "--format", "{{.Server.Version}}"],
                           capture_output=True, timeout=20)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def binary() -> Path | None:
    """Сервер на Rust: заданный явно, собранный здесь, потом из PATH.

    В PATH может оказаться и этот самый скрипт — тогда репозиторий лежит
    в PATH целиком, и бинарником он не считается.
    """
    explicit = os.environ.get("VOICY_BIN")
    if explicit:
        return Path(explicit)
    if BUILT.exists():
        return BUILT
    found = shutil.which(EXE)
    if found and Path(found).resolve() != Path(__file__).resolve():
        return Path(found)
    return None


def cargo() -> str | None:
    """rustup кладёт cargo в ~/.cargo/bin, а в PATH его добавляет только новый вход."""
    found = shutil.which("cargo")
    if found:
        return found
    home = Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo") / "bin"
    exe = home / ("cargo.exe" if os.name == "nt" else "cargo")
    return str(exe) if exe.exists() else None


def build() -> Path:
    """Собирает бинарник из rust/. Минуты при первой сборке, дальше быстро."""
    tool = cargo()
    if not tool:
        die("для сборки нужен Rust: https://rustup.rs, затем повторите команду;\n"
            "  либо возьмите готовый бинарник из выпусков и укажите его в VOICY_BIN")
    cmd = [tool, *BUILD]
    log("$ " + " ".join(cmd))
    if subprocess.run(cmd, cwd=HERE).returncode != 0:
        die("сборка оборвалась — смотрите вывод выше")
    return BUILT


def up_native(a) -> int:
    """Сервер на Rust обычным процессом: без docker и без Python.

    Библиотеки и модели бинарник ставит сам (`setup`): при полном кэше это
    мгновенно и в сеть не ходит, иначе спрашивает, прежде чем качать.
    Дальше `up` бинарника — он же держит pid и журнал и прогревает модели.
    """
    exe = binary()
    if exe is None and a.install:
        exe = build()
    if exe is None:
        die(f"бинарника voicy нет: ни {BUILT.relative_to(HERE)}, ни в PATH.\n"
            f"  собрать: cargo build --release --manifest-path rust/Cargo.toml\n"
            f"  или одной командой: {sys.argv[0]} up --native --install\n"
            f"  или готовый файл из выпусков — путь в VOICY_BIN")
    setup = [str(exe), "setup"] + (["--yes"] if a.install else [])
    code = subprocess.run(setup).returncode
    if code != 0:
        if NATIVE_ENGINES:
            return code                 # почему — setup сказал сам
        # Библиотек движков под эту систему ещё нет: сервер возьмёт движки на Python
        # из server/engines — нужен .venv с server/requirements.txt и torch.
        log("родных движков под эту систему нет — сервер возьмёт Python-движки из .venv "
            "(server/requirements.txt и torch)")
    cmd = [str(exe), "--url", a.url, "up", "--wait", str(a.wait)]
    if a.cpu:
        cmd.append("--cpu")
    if not a.warm:
        cmd.append("--no-warm")
    return subprocess.run(cmd).returncode


def up_docker(a, port: int) -> None:
    if a.cpu:
        # Мимо compose: там GPU затребован в deploy.reservations, и на машине
        # без видеокарты запуск падает ещё до того, как FORCE_CPU кто-то прочтёт.
        cmd = ["docker", "run", "-d", "--name", "voicy", "--restart", "unless-stopped",
               "-p", f"{port}:8080", "-e", "FORCE_CPU=1",
               *[x for v in ("VOICY_API_KEY", "VOICY_PUBLIC_URL") if os.environ.get(v)
                 for x in ("-e", v)],
               "-v", "voicy-models:/cache", "-v", "voicy-voices:/app/server/voices",
               "-v", "voicy-contexts:/app/server/contexts",
               IMAGE]
        env = dict(os.environ)
    else:
        cmd = ["docker", "compose", "up", "-d"]
        if a.build:
            cmd.append("--build")
        env = {**os.environ, "VOICY_PORT": str(port)}
    log("$ " + " ".join(cmd))
    if subprocess.run(cmd, cwd=HERE, env=env).returncode != 0:
        die("сервер не поднялся — смотрите вывод выше")


def cmd_up(a) -> int:
    if health(a.url):
        log(f"voicy уже работает на {a.url}")
        return cmd_warm(a) if a.warm else 0

    mode = a.mode
    if mode == "auto":
        mode = "docker" if docker_available() else "native"
        if mode == "native":
            log("docker недоступен — поднимаю бинарником на Rust")
    if mode == "native":
        return up_native(a)

    up_docker(a, urlsplit(a.url).port or 8080)
    if a.cpu:
        log("режим без GPU: синтез идёт медленнее реального времени")
    # Первый запуск качает около восьми гигабайт моделей, поэтому запас большой.
    log("ждём готовности (первый запуск качает модели, это долго) …")
    wait_healthy(a.url, time.time() + a.wait)
    log(f"voicy на {a.url}, консоль там же")
    return cmd_warm(a) if a.warm else 0


def cmd_down(a) -> int:
    stopped = False
    exe = binary()
    if exe:
        # бинарник останавливает только то, что поднял сам; чужое не трогает
        subprocess.run([str(exe), "--url", a.url, "down"])
        stopped = True
    if docker_available():
        log("$ docker compose down")
        subprocess.run(["docker", "compose", "down"], cwd=HERE)
        # Контейнер без GPU поднят не через compose, и она его не видит.
        subprocess.run(["docker", "rm", "-f", "voicy"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        stopped = True
    if not stopped:
        log("нечего останавливать: docker недоступен, бинарника нет")
    return 0



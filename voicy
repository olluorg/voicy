# Имена для импорта, а не для установки: python-multipart ставится под одним
# именем, а импортируется под другим.
NEEDED = ("fastapi", "uvicorn", "multipart", "numpy", "soundfile", "soxr", "scipy",
          "onnxruntime", "torch", "transformers", "qwen_tts", "faster_whisper")


def docker_available() -> bool:
    """Docker может быть не установлен, а может быть сломан — разницы нет."""
    try:
        r = subprocess.run(["docker", "version", "--format", "{{.Server.Version}}"],
                           capture_output=True, timeout=20)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def interpreter() -> Path:
    """Чем запускать сервер: заданное явно, потом .venv рядом, потом текущее."""
    explicit = os.environ.get("VOICY_PYTHON")
    if explicit:
        return Path(explicit)
    for rel in (".venv/bin/python", ".venv/Scripts/python.exe"):
        p = HERE / rel
        if p.exists():
            return p
    return Path(sys.executable)


def missing_modules(py: Path) -> list[str]:
    code = ("import importlib.util as u, sys; "
            "print(' '.join(m for m in sys.argv[1:] if u.find_spec(m) is None))")
    try:
        r = subprocess.run([str(py), "-c", code, *NEEDED],
                           capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return list(NEEDED)
    return list(NEEDED) if r.returncode != 0 else r.stdout.split()


def torch_index() -> str:
    """Колёса torch под CUDA весят втрое больше и без видеокарты бесполезны."""
    if os.environ.get("VOICY_TORCH_INDEX"):
        return os.environ["VOICY_TORCH_INDEX"]
    return ("https://download.pytorch.org/whl/cu128" if shutil.which("nvidia-smi")
            else "https://download.pytorch.org/whl/cpu")


def install_hint(py: Path) -> str:
    idx = torch_index()
    return (f"    uv venv --python 3.12 .venv\n"
            f"    uv pip install --python .venv torch torchaudio --index-url {idx}\n"
            f"    uv pip install --python .venv -r server/requirements.txt\n"
            f"  либо одной командой: {sys.argv[0]} up --source --install")


def run_step(cmd: list[str]) -> None:
    log("$ " + " ".join(cmd))
    if subprocess.run(cmd, cwd=HERE).returncode != 0:
        die("установка оборвалась — смотрите вывод выше")


def install_deps() -> Path:
    """Ставит окружение в .venv рядом с репозиторием. Качает гигабайты."""
    venv = HERE / ".venv"
    uv = shutil.which("uv")
    idx = torch_index()
    log(f"ставлю зависимости в {venv} (torch с {idx}); это гигабайты и не быстро")
    if uv:
        if not venv.exists():
            run_step([uv, "venv", "--python", "3.12", str(venv)])
        run_step([uv, "pip", "install", "--python", str(venv),
                  "torch", "torchaudio", "--index-url", idx])
        run_step([uv, "pip", "install", "--python", str(venv),
                  "-r", str(HERE / "server" / "requirements.txt")])
    else:
        if not venv.exists():
            run_step([sys.executable, "-m", "venv", str(venv)])
        pip = str(venv / ("Scripts/pip.exe" if os.name == "nt" else "bin/pip"))
        run_step([pip, "install", "-U", "pip"])
        run_step([pip, "install", "torch", "torchaudio", "--index-url", idx])
        run_step([pip, "install", "-r", str(HERE / "server" / "requirements.txt")])
    return interpreter()


def alive(pid: int) -> bool:
    if os.name == "nt":
        # os.kill(pid, 0) на Windows не проверяет процесс, а завершает его
        import ctypes
        k = ctypes.windll.kernel32
        h = k.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if not h:
            return False
        code = ctypes.c_ulong()
        ok = k.GetExitCodeProcess(h, ctypes.byref(code))
        k.CloseHandle(h)
        return bool(ok) and code.value == 259  # STILL_ACTIVE
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def read_pid() -> int | None:
    try:
        pid = int(PID_FILE.read_text().strip())
    except (OSError, ValueError):
        return None
    return pid if alive(pid) else None


def up_source(a, port: int) -> None:
    """Сервер как обычный процесс: без docker, из исходников этого репозитория."""
    py = interpreter()
    missing = missing_modules(py)
    if missing and a.install:
        py = install_deps()
        missing = missing_modules(py)
    if missing:
        die(f"в {py} не хватает: {', '.join(missing)}\n"
            f"  поставить:\n{install_hint(py)}")

    if not shutil.which("ffmpeg"):
        log("ffmpeg не найден: синтез в opus/mp3/flac/aac и изменение темпа откажут, "
            "wav и распознавание — нет. Поставить: sudo apt install ffmpeg, "
            "brew install ffmpeg или winget install Gyan.FFmpeg")

    RUNTIME_DIR.mkdir(exist_ok=True)
    env = dict(os.environ)
    if a.cpu:
        env["FORCE_CPU"] = "1"
    cmd = [str(py), "-m", "uvicorn", "app:app",
           "--host", "127.0.0.1", "--port", str(port), "--app-dir", "server"]
    log("$ " + " ".join(cmd))
    with open(LOG_FILE, "ab") as logf:
        logf.write(f"\n=== {time.strftime('%F %T')} запуск ===\n".encode())
        # Отдельная сессия — чтобы сервер пережил завершение этой команды.
        detach = ({"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS}
                  if os.name == "nt" else {"start_new_session": True})
        proc = subprocess.Popen(cmd, cwd=HERE, env=env, stdout=logf, stderr=logf,
                                stdin=subprocess.DEVNULL, **detach)
    PID_FILE.write_text(str(proc.pid))
    log(f"процесс {proc.pid}, журнал — {LOG_FILE}")


def up_docker(a, port: int) -> None:
    if a.cpu:
        # Мимо compose: там GPU затребован в deploy.reservations, и на машине
        # без видеокарты запуск падает ещё до того, как FORCE_CPU кто-то прочтёт.
        cmd = ["docker", "run", "-d", "--name", "voicy", "--restart", "unless-stopped",
               "-p", f"{port}:8080", "-e", "FORCE_CPU=1",
               *[x for v in ("VOICY_API_KEY", "VOICY_PUBLIC_URL") if os.environ.get(v)
                 for x in ("-e", v)],
               "-v", "voicy-models:/cache", "-v", "voicy-voices:/app/server/voices",
               "-v", "voicy-contexts:/app/server/contexts",
               IMAGE]
        env = dict(os.environ)
    else:
        cmd = ["docker", "compose", "up", "-d"]
        if a.build:
            cmd.append("--build")
        env = {**os.environ, "VOICY_PORT": str(port)}
    log("$ " + " ".join(cmd))
    if subprocess.run(cmd, cwd=HERE, env=env).returncode != 0:
        die("сервер не поднялся — смотрите вывод выше")


def cmd_up(a) -> int:
    if health(a.url):
        log(f"voicy уже работает на {a.url}")
        return cmd_warm(a) if a.warm else 0

    port = urlsplit(a.url).port or 8080
    mode = a.mode
    if mode == "auto":
        mode = "docker" if docker_available() else "source"
        if mode == "source":
            log("docker недоступен — поднимаю из исходников")
    if mode == "docker":
        up_docker(a, port)
    else:
        up_source(a, port)
    if a.cpu:
        log("режим без GPU: синтез идёт медленнее реального времени")

    # Первый запуск качает около пяти гигабайт весов, поэтому запас большой.
    log("ждём готовности (первый запуск качает веса, это долго) …")
    wait_healthy(a.url, time.time() + a.wait)
    log(f"voicy на {a.url}, консоль там же")
    return cmd_warm(a) if a.warm else 0


def cmd_down(a) -> int:
    stopped = False
    pid = read_pid()
    if pid:
        log(f"останавливаю процесс {pid}")
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if read_pid() is None:
                break
            time.sleep(0.2)
        if read_pid() is not None:
            os.kill(pid, getattr(signal, "SIGKILL", signal.SIGTERM))
        PID_FILE.unlink(missing_ok=True)
        stopped = True
    if docker_available():
        log("$ docker compose down")
        subprocess.run(["docker", "compose", "down"], cwd=HERE)
        # Контейнер без GPU поднят не через compose, и она его не видит.
        subprocess.run(["docker", "rm", "-f", "voicy"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        stopped = True
    if not stopped:
        log("нечего останавливать: docker недоступен, своего процесса нет")
    return 0


